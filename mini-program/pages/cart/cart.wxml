<!--pages/cart/cart.wxml - 购物车页面-->
<view class="page">
  <!-- 购物车列表 -->
  <view class="cart-list" wx:if="{{cartList.length > 0}}">
    <view class="cart-item" wx:for="{{cartList}}" wx:key="id">
      <image class="item-img" src="{{item.dishImage || '/images/default-dish.png'}}" mode="aspectFill" />
      <view class="item-info">
        <view class="item-name">{{item.dishName}}</view>
        <view class="item-price price">¥{{item.price}}</view>
      </view>
      <view class="item-actions">
        <stepper value="{{item.quantity}}" min="0" max="99" data-index="{{index}}" bindchange="changeQuantity" />
      </view>
    </view>
  </view>

  <!-- 空购物车 -->
  <view class="empty-state" wx:else>
    <text>购物车是空的，快去点餐吧~</text>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar safe-bottom" wx:if="{{cartList.length > 0}}">
    <view class="bar-left">
      <text class="total-label">合计：</text>
      <text class="total-price price">¥{{totalPrice}}</text>
    </view>
    <view class="bar-right">
      <view class="clear-btn" bindtap="clearCart">清空</view>
      <view class="submit-btn" bindtap="goConfirm">去下单</view>
    </view>
  </view>
</view>
