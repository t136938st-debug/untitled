<!--
  购物车页：列表 + 加减 + 清空 + 结算
-->
<view class="page-cart">
  <!-- 购物车列表 -->
  <view class="cart-list" wx:if="{{items.length > 0}}">
    <view class="cart-item" wx:for="{{items}}" wx:key="id">
      <image
        class="item-img"
        src="{{item.dishImage || '/images/placeholder.png'}}"
        mode="aspectFill"
      />
      <view class="item-info">
        <text class="item-name">{{item.dishName}}</text>
        <text class="item-price price">¥{{item.price}}</text>
      </view>
      <view class="item-ctrl">
        <view class="ctrl-btn" catchtap="onMinus" data-item="{{item}}">-</view>
        <text class="ctrl-num">{{item.quantity}}</text>
        <view class="ctrl-btn" catchtap="onPlus" data-item="{{item}}">+</view>
      </view>
      <view class="item-del" catchtap="onRemove" data-item="{{item}}">
        <text>删除</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{items.length === 0}}">
    <text>购物车空空如也~</text>
    <view class="btn-primary go-order" bindtap="goShopping">去点餐</view>
  </view>

  <!-- 底部结算栏 -->
  <view class="bottom-bar" wx:if="{{items.length > 0}}">
    <view class="bar-left">
      <text>合计：</text>
      <text class="price total-price">¥{{totalAmount}}</text>
    </view>
    <view class="bar-right">
      <view class="clear-btn" bindtap="onClear">清空</view>
      <view class="submit-btn" bindtap="goConfirm">
        去结算({{totalCount}})
      </view>
    </view>
  </view>
</view>
