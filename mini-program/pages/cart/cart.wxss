.page-cart {
  min-height: 100vh;
  padding-bottom: 140rpx;
  background-color: #f5f5f5;
}

.cart-list {
  padding: 20rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.item-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-price {
  font-size: 30rpx;
}

/* 加减控制 */
.item-ctrl {
  display: flex;
  align-items: center;
  margin-right: 16rpx;
}

.ctrl-btn {
  width: 48rpx;
  height: 48rpx;
  background-color: #ff6633;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  border-radius: 8rpx;
}

.ctrl-num {
  min-width: 56rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: bold;
}

/* 删除按钮 */
.item-del {
  flex-shrink: 0;
}

.item-del text {
  font-size: 24rpx;
  color: #999;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 160rpx 0;
  color: #999;
}

.go-order {
  margin-top: 40rpx;
  display: inline-block;
  padding: 20rpx 60rpx;
}

/* 底部结算栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #fff;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.bar-left {
  display: flex;
  align-items: baseline;
}

.total-price {
  font-size: 36rpx;
}

.bar-right {
  display: flex;
  align-items: center;
}

.clear-btn {
  font-size: 26rpx;
  color: #999;
  margin-right: 24rpx;
}

.submit-btn {
  background-color: #ff6633;
  color: #fff;
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
}
