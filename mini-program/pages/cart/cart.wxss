/* pages/cart/cart.wxss */
.page {
  min-height: 100vh;
  padding-bottom: 140rpx;
}

.cart-list {
  padding: 20rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.item-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  margin: 0 20rpx;
}

.item-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.item-price {
  font-size: 32rpx;
  margin-top: 12rpx;
}

.item-actions {
  flex-shrink: 0;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  padding: 20rpx 24rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.06);
}

.bar-left {
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 28rpx;
  color: #666;
}

.total-price {
  font-size: 40rpx;
}

.bar-right {
  display: flex;
  align-items: center;
}

.clear-btn {
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  color: #999;
  border: 2rpx solid #ddd;
  border-radius: 30rpx;
  margin-right: 16rpx;
}

.submit-btn {
  padding: 16rpx 40rpx;
  font-size: 28rpx;
  color: #fff;
  background: #e6522c;
  border-radius: 30rpx;
  font-weight: bold;
}

/* stepper 组件样式 */
stepper {
  display: flex;
  align-items: center;
}
