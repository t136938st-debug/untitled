<!--
  菜品详情页：图片 + 信息 + 数量选择 + 加入购物车
-->
<view class="page-detail" wx:if="{{dish}}">
  <!-- 菜品图片 -->
  <view class="img-wrap">
    <image
      class="dish-img"
      src="{{dish.image || '/images/placeholder.png'}}"
      mode="aspectFill"
    />
  </view>

  <!-- 菜品信息 -->
  <view class="info-card">
    <text class="dish-name">{{dish.name}}</text>
    <view class="dish-price-row">
      <text class="price">¥{{dish.price}}</text>
      <text class="sales" wx:if="{{dish.sales}}">月售{{dish.sales}}</text>
    </view>
    <text class="dish-desc" wx:if="{{dish.description}}">{{dish.description}}</text>
  </view>

  <!-- 数量选择 -->
  <view class="quantity-row">
    <text>数量</text>
    <view class="quantity-ctrl">
      <view class="btn-minus {{quantity <= 1 ? 'disabled' : ''}}" bindtap="onMinus">-</view>
      <text class="quantity-num">{{quantity}}</text>
      <view class="btn-plus" bindtap="onPlus">+</view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="btn-primary btn-block" bindtap="addToCart">
      加入购物车 · ¥{{dish.price * quantity}}
    </view>
  </view>
</view>
