.page-detail {
  padding-bottom: 140rpx;
}

.img-wrap {
  width: 100%;
  height: 500rpx;
}

.dish-img {
  width: 100%;
  height: 100%;
}

.info-card {
  padding: 30rpx;
  background-color: #fff;
  margin-bottom: 20rpx;
}

.dish-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.dish-price-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.dish-price-row .price {
  font-size: 40rpx;
}

.sales {
  font-size: 24rpx;
  color: #999;
  margin-left: 16rpx;
}

.dish-desc {
  font-size: 26rpx;
  color: #666;
  display: block;
  line-height: 1.6;
}

/* 数量选择 */
.quantity-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  background-color: #fff;
  margin-bottom: 20rpx;
  font-size: 30rpx;
}

.quantity-ctrl {
  display: flex;
  align-items: center;
}

.btn-minus, .btn-plus {
  width: 56rpx;
  height: 56rpx;
  background-color: #ff6633;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  border-radius: 8rpx;
}

.btn-minus.disabled {
  background-color: #ddd;
  color: #999;
}

.quantity-num {
  min-width: 80rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}
