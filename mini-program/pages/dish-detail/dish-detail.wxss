/* pages/dish-detail/dish-detail.wxss */
.page {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.dish-hero {
  width: 100%;
  height: 500rpx;
}

.dish-info {
  background: #fff;
  padding: 30rpx;
  margin: 20rpx;
  border-radius: 16rpx;
}

.dish-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.dish-price {
  font-size: 40rpx;
  margin-top: 16rpx;
}

.dish-desc {
  font-size: 26rpx;
  color: #999;
  margin-top: 16rpx;
  line-height: 1.6;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #fff;
  padding: 16rpx 24rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.06);
}

.back-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 30rpx;
  color: #666;
  border: 2rpx solid #ddd;
  border-radius: 40rpx;
  margin-right: 16rpx;
}

.add-cart-btn {
  flex: 2;
  text-align: center;
  padding: 20rpx;
  font-size: 30rpx;
  color: #fff;
  background: #e6522c;
  border-radius: 40rpx;
  font-weight: bold;
}
