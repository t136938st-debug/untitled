<!--pages/index/index.wxml - 首页：左侧分类 + 右侧菜品列表-->
<view class="page">
  <!-- 顶部桌号提示 -->
  <view class="table-bar" wx:if="{{tableId}}">
    <text>当前桌号：{{tableId}}</text>
  </view>

  <view class="content">
    <!-- 左侧分类栏 -->
    <scroll-view class="category-sidebar" scroll-y>
      <view
        class="category-item {{activeCategoryId === item.id ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="selectCategory"
      >
        {{item.name}}
      </view>
    </scroll-view>

    <!-- 右侧菜品列表 -->
    <scroll-view class="dish-list" scroll-y>
      <view class="dish-card" wx:for="{{dishes}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
        <image class="dish-img" src="{{item.image || '/images/default-dish.png'}}" mode="aspectFill" />
        <view class="dish-info">
          <view class="dish-name">{{item.name}}</view>
          <view class="dish-desc">{{item.description || '暂无描述'}}</view>
          <view class="dish-bottom">
            <text class="price">¥{{item.price}}</text>
            <view class="add-btn" catchtap="addToCart" data-id="{{item.id}}">+</view>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{dishes.length === 0}}">
        <text>该分类暂无菜品</text>
      </view>
    </scroll-view>
  </view>
</view>
