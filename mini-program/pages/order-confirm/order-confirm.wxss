.page-confirm {
  padding: 20rpx;
  padding-bottom: 160rpx;
}

.section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.table-info {
  font-size: 30rpx;
  color: #ff6633;
  font-weight: bold;
}

.table-info.no-table {
  color: #999;
  font-weight: normal;
  font-size: 26rpx;
}

/* 订单菜品列表 */
.order-items {
  border-top: 1rpx solid #f0f0f0;
}

.order-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.item-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.item-qty {
  font-size: 26rpx;
  color: #999;
  margin-right: 24rpx;
}

.item-price {
  font-size: 28rpx;
}

/* 备注输入 */
.remark-input {
  width: 100%;
  height: 160rpx;
  font-size: 26rpx;
  padding: 16rpx;
  box-sizing: border-box;
  background-color: #f9f9f9;
  border-radius: 8rpx;
}

/* 合计 */
.total-row {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.total-amount {
  font-size: 40rpx;
}

/* 提交按钮 */
.submit-area {
  padding: 30rpx;
}

.submit-btn {
  font-size: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
}
