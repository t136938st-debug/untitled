<!--pages/order-detail/order-detail.wxml - 订单详情页-->
<view class="page" wx:if="{{order}}">
  <!-- 订单状态卡片 -->
  <view class="status-card" style="background: {{statusColor[order.status]}}">
    <text class="status-text">{{statusMap[order.status]}}</text>
    <text class="status-desc" wx:if="{{order.status === 0}}">请在30分钟内完成支付</text>
    <text class="status-desc" wx:if="{{order.status === 1}}">感谢您的惠顾</text>
  </view>

  <!-- 订单信息 -->
  <view class="section">
    <view class="section-title">订单信息</view>
    <view class="info-row">
      <text class="label">订单号</text>
      <text class="value">{{order.orderNo}}</text>
    </view>
    <view class="info-row">
      <text class="label">下单时间</text>
      <text class="value">{{order.createTime}}</text>
    </view>
    <view class="info-row" wx:if="{{order.payTime}}">
      <text class="label">支付时间</text>
      <text class="value">{{order.payTime}}</text>
    </view>
    <view class="info-row" wx:if="{{order.remark}}">
      <text class="label">备注</text>
      <text class="value">{{order.remark}}</text>
    </view>
  </view>

  <!-- 菜品明细 -->
  <view class="section">
    <view class="section-title">菜品明细</view>
    <view class="detail-list">
      <view class="detail-item" wx:for="{{details}}" wx:key="id">
        <image class="detail-img" src="{{item.dishImage || '/images/default-dish.png'}}" mode="aspectFill" />
        <view class="detail-info">
          <text class="detail-name">{{item.dishName}}</text>
          <text class="detail-qty">x{{item.quantity}}</text>
        </view>
        <text class="detail-price price">¥{{item.price * item.quantity}}</text>
      </view>
    </view>
    <view class="total-row">
      <text>合计</text>
      <text class="total-amount price">¥{{order.totalAmount}}</text>
    </view>
  </view>

  <!-- 底部操作 -->
  <view class="bottom-bar safe-bottom" wx:if="{{order.status === 0}}">
    <view class="pay-btn" bindtap="simPay">模拟支付 ¥{{order.totalAmount}}</view>
  </view>
</view>
