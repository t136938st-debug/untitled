<!--
  订单详情页：状态卡片 + 订单信息 + 菜品明细 + 操作按钮
-->
<view class="page-order-detail" wx:if="{{order}}">
  <!-- 状态卡片 -->
  <view class="status-card" style="background-color: {{order.statusColor}}">
    <text class="status-text">{{order.statusText}}</text>
    <text class="status-tip" wx:if="{{order.status === 0}}">请在30分钟内完成支付</text>
    <text class="status-tip" wx:if="{{order.status === 1}}">感谢您的支付</text>
  </view>

  <!-- 订单信息 -->
  <view class="info-section">
    <view class="info-row">
      <text class="label">订单号</text>
      <text class="value">{{order.orderNo}}</text>
    </view>
    <view class="info-row">
      <text class="label">下单时间</text>
      <text class="value">{{order.createTime}}</text>
    </view>
    <view class="info-row" wx:if="{{order.tableId}}">
      <text class="label">桌号</text>
      <text class="value">{{order.tableId}}号桌</text>
    </view>
    <view class="info-row" wx:if="{{order.remark}}">
      <text class="label">备注</text>
      <text class="value">{{order.remark}}</text>
    </view>
    <view class="info-row" wx:if="{{order.payTime}}">
      <text class="label">支付时间</text>
      <text class="value">{{order.payTime}}</text>
    </view>
  </view>

  <!-- 菜品明细 -->
  <view class="dish-section">
    <view class="section-title">菜品明细</view>
    <view class="dish-list">
      <view class="dish-item" wx:for="{{order.items}}" wx:key="dishId">
        <image
          class="dish-img"
          src="{{item.image || '/images/placeholder.png'}}"
          mode="aspectFill"
        />
        <view class="dish-info">
          <text class="dish-name">{{item.dishName}}</text>
          <text class="dish-price price">¥{{item.price}}</text>
        </view>
        <text class="dish-qty">x{{item.quantity}}</text>
      </view>
    </view>
    <view class="total-row">
      <text>合计</text>
      <text class="price total-amount">¥{{order.totalAmount}}</text>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-bar" wx:if="{{order.status === 0 || order.status === 1}}">
    <button
      class="action-btn cancel-btn"
      wx:if="{{order.status === 0}}"
      bindtap="cancelOrder"
    >取消订单</button>
    <button
      class="action-btn pay-btn"
      wx:if="{{order.status === 0}}"
      bindtap="simPay"
    >模拟支付</button>
  </view>
</view>
