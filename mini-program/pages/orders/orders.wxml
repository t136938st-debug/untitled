<!--pages/orders/orders.wxml - 我的订单页面-->
<view class="page">
  <view class="order-list" wx:if="{{orders.length > 0}}">
    <view class="order-card" wx:for="{{orders}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <!-- 订单头部 -->
      <view class="order-header">
        <text class="order-no">订单号：{{item.orderNo}}</text>
        <text class="order-status" style="color: {{statusColor[item.status]}}">{{statusMap[item.status]}}</text>
      </view>

      <!-- 订单金额 -->
      <view class="order-body">
        <text class="order-amount price">¥{{item.totalAmount}}</text>
        <text class="order-time">{{item.createTime}}</text>
      </view>

      <!-- 操作按钮 -->
      <view class="order-actions" catchtap="">
        <view class="action-btn cancel" wx:if="{{item.status === 0}}" catchtap="cancelOrder" data-id="{{item.id}}">取消订单</view>
        <view class="action-btn pay" wx:if="{{item.status === 0}}" catchtap="simPay" data-id="{{item.id}}">模拟支付</view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <text>暂无订单</text>
    <view class="go-order-btn" bindtap="goMenu">去点餐</view>
  </view>
</view>
